    {
      "parameters": {
        "jsCode": "// Format specialties list message\nconst specialties = $json.data;\nconst phone = $('Extract Message Data').first().json.phone;\n\nlet message = \"AGENDAMENTO DE CONSULTA\\n\\n\";\nmessage += \"Para agendar sua consulta, preciso de algumas informacoes.\\n\\n\";\nmessage += \"Especialidades disponiveis:\\n\";\n\nspecialties.forEach((specialty, index) => {\n  message += `${index + 1}. ${specialty.name}\\n`;\n});\n\nmessage += \"\\nDigite o NUMERO da especialidade desejada:\";\n\nreturn [{\n  phone,\n  message,\n  specialties,\n  nextState: 'waiting_specialty'\n}];"
      },
