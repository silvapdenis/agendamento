    {
      "parameters": {
        "jsCode": "// Check if message contains appointment keywords\nconst messageText = $('Extract Message Data').first().json.messageText.toLowerCase();\nconst appointmentKeywords = ['agendar', 'consulta', 'médico', 'doutor', 'horário', 'marcar'];\n\nconst isAppointmentRequest = appointmentKeywords.some(keyword => \n  messageText.includes(keyword)\n);\n\nreturn [{\n  isAppointmentRequest,\n  messageText,\n  phoneNumber: $('Extract Message Data').first().json.phoneNumber\n}];"
      },
