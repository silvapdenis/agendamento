      "id": "webhook-start",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 400]
    },
    {
      "parameters": {
        "jsCode": "// Extract WhatsApp message data\nconst payload = $input.all()[0].json;\n\n// Validate webhook structure\nif (!payload.entry || !payload.entry[0] || !payload.entry[0].changes || !payload.entry[0].changes[0]) {\n  return [{ error: 'Invalid webhook payload' }];\n}\n\nconst change = payload.entry[0].changes[0];\nconst value = change.value;\n\n// Check if there are messages\nif (!value.messages || value.messages.length === 0) {\n  return [{ error: 'No messages found' }];\n}\n\nconst message = value.messages[0];\nconst contact = value.contacts ? value.contacts[0] : null;\n\n// Extract relevant data\nreturn [{\n  phoneNumber: message.from,\n  messageText: message.text ? message.text.body : '',\n  messageType: message.type,\n  messageId: message.id,\n  timestamp: message.timestamp,\n  contactName: contact ? contact.profile.name : '',\n  isTextMessage: message.type === 'text'\n}];"
      },
      "id": "extract-data",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.isTextMessage }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ]
        }
      },
      "id": "check-text",
