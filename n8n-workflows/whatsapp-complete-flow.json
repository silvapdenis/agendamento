      "id": "get-specialties",
      "name": "Get Specialties",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 60]
    },
    {
      "parameters": {
        "jsCode": "// Format welcome message\nconst phoneNumber = $('Extract Message Data').first().json.phoneNumber;\n\nconst message = \"👋 Olá! Bem-vindo ao sistema de agendamento!\\n\\n\" +\n               \"🏥 Eu posso ajudá-lo a:\\n\" +\n               \"• Agendar consultas médicas\\n\" +\n               \"• Verificar horários disponíveis\\n\" +\n               \"• Confirmar agendamentos\\n\\n\" +\n               \"Para começar, digite:\\n\" +\n               \"*agendar consulta*\";\n\nreturn [{\n  phoneNumber,\n  message,\n  nextState: 'initial',\n  context: {}\n}];"
      },
      "id": "format-welcome",
      "name": "Format Welcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 140]
    },
    {
      "parameters": {
        "jsCode": "// Format specialties message\nconst specialties = $json.data;\nconst phoneNumber = $('Extract Message Data').first().json.phoneNumber;\n\nlet message = \"🏥 *Agendamento de Consulta*\\n\\n\";\nmessage += \"Para agendar sua consulta, preciso de algumas informações.\\n\\n\";\nmessage += \"*Especialidades disponíveis:*\\n\";\n\nspecialties.forEach((specialty, index) => {\n  message += `${index + 1}. ${specialty.name}\\n`;\n});\n\nmessage += \"\\n📝 Digite o *número* da especialidade desejada:\";\n\nreturn [{\n  phoneNumber,\n  message,\n  nextState: 'waiting_specialty',\n  context: { specialties }\n}];"
      },
      "id": "format-specialties",
      "name": "Format Specialties",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 60]
    },
    {
      "parameters": {
        "jsCode": "// Handle specialty selection\nconst messageText = $('Extract Message Data').first().json.messageText;\nconst phoneNumber = $('Extract Message Data').first().json.phoneNumber;\nconst context = $('Get Conversation State').first().json.context;\nconst specialties = context.specialties;\n\nconst specialtyIndex = parseInt(messageText) - 1;\n\nif (isNaN(specialtyIndex) || !specialties || !specialties[specialtyIndex]) {\n  return [{\n    phoneNumber,\n    message: \"❌ Opção inválida. Por favor, digite o número de uma especialidade válida.\",\n    nextState: 'waiting_specialty',\n    context: context,\n    isError: true\n  }];\n}\n\nconst selectedSpecialty = specialties[specialtyIndex];\n\nreturn [{\n  phoneNumber,\n  selectedSpecialty,\n  specialtyId: selectedSpecialty.id,\n  context: { ...context, selectedSpecialty }\n}];"
      },
      "id": "handle-specialty",
      "name": "Handle Specialty Selection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 200]
    },
