            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "start_appointment",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "check-appointment-intent",
      "name": "Start Appointment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
