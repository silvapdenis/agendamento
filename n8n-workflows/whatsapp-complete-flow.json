    {
      "parameters": {
        "jsCode": "// Handle initial state - detect appointment intent\nconst messageText = $('Extract Message Data').first().json.messageText.toLowerCase();\nconst appointmentKeywords = ['agendar', 'consulta', 'médico', 'doutor', 'horário', 'marcar'];\n\nconst isAppointmentRequest = appointmentKeywords.some(keyword => \n  messageText.includes(keyword)\n);\n\nif (isAppointmentRequest) {\n  return [{ action: 'start_appointment' }];\n} else {\n  return [{ action: 'show_welcome' }];\n}"
      },
      "id": "handle-initial",
      "name": "Handle Initial State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
