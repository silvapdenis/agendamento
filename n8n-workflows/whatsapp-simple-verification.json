      "webhookId": "whatsapp-verify"
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp webhook verification\nconst params = $input.item.json.query || {};\nconst mode = params['hub.mode'];\nconst token = params['hub.verify_token'];\nconst challenge = params['hub.challenge'];\n\n// Verify token\nif (mode === 'subscribe' && token === 'medico_bot_2025') {\n  // Return challenge as plain number for response\n  return [{ json: { responseBody: challenge, responseCode: 200 } }];\n} else {\n  throw new Error('Invalid verification token');\n}"
      },
      "id": "code-node",
      "name": "Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseCode": 200,
        "responseBody": "={{ $json.responseBody }}",
        "options": {}
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-whatsapp",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-post-node",
      "name": "Webhook POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 500],
      "webhookId": "whatsapp-messages"
    },
    {
      "parameters": {
        "jsCode": "// Extract WhatsApp message data\nconst body = $input.item.json.body;\n\nif (!body || !body.entry || !body.entry[0]) {\n  return { status: 'no_data' };\n}\n\nconst entry = body.entry[0];\nif (!entry.changes || !entry.changes[0]) {\n  return { status: 'no_changes' };\n}\n\nconst change = entry.changes[0];\nif (!change.value || !change.value.messages || !change.value.messages[0]) {\n  return { status: 'no_messages' };\n}\n\nconst message = change.value.messages[0];\nconst phone = message.from;\nconst text = message.text ? message.text.body : '';\n\nreturn {\n  phone: phone,\n  message: text,\n  messageId: message.id,\n  timestamp: message.timestamp\n};"
      },
      "id": "extract-node",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 500]
    },
