{
  "name": "medical-appointment-bot",
  "version": "1.0.0",
  "description": "Medical appointment system with WhatsApp integration via n8n",
  "main": "public/index.php",
  "scripts": {
    "build": "composer install --optimize-autoloader --no-dev --no-scripts",
    "start": "bash start.sh",
    "deploy": "railway deploy",
    "migrate": "php artisan migrate --force",
    "seed": "php artisan db:seed --force"
  },
  "engines": {
    "php": "^8.1",
    "node": "18.x"
  },
  "dependencies": {
    "railway": "^3.0.0"
  },
  "railway": {
    "build": {
      "buildCommand": "composer install --optimize-autoloader --no-dev"
    },
    "deploy": {
      "startCommand": "bash start.sh",
      "healthcheckPath": "/api/health"
    }
  }
}